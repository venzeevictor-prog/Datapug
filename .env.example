DATABASE_URL=postgresql://user:password@localhost:5432/dataplug
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
PORT=3000
NODE_ENV=development

# Public URL of this app — used to build links in emails (password reset, etc.)
# and to fill in canonical/Open Graph URLs on the landing page and robots.txt/sitemap.xml.
# Use your real production domain (with https://, no trailing slash) once deployed.
APP_URL=http://localhost:3000

# Paystack — customer wallet funding
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://yourdomain.com/payment-callback.html

# Comma-separated list of allowed frontend origins in production (leave blank in dev)
ALLOWED_ORIGINS=https://yourdomain.com

# VTPass — only used once, to seed the `providers` table on first migration. After
# that, edit these from the admin portal; these env vars are no longer read.
# VTPass needs THREE separate credentials, not one — see services/provider.js.
# Sandbox base URL: https://sandbox.vtpass.com/api — use this to test before going live.
# Live base URL: https://vtpass.com/api
VTPASS_API_URL=https://vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
MARKUP_MULTIPLIER=1.15

# Minimum wallet funding amount, in naira. Also the referral program's qualifying
# deposit threshold (see services/referral.js) — any successful funding at all qualifies.
MIN_FUNDING_NAIRA=1000

# Hard ceiling on any single funding credit, in naira — a safety net against a bug ever
# silently crediting an absurd amount. No legitimate deposit should be anywhere near this.
MAX_FUNDING_NAIRA=2000000

# Resend — required for password reset emails to actually send. If left blank, reset
# emails are only logged to the server console (fine for local dev, not for production).
# Get RESEND_API_KEY from resend.com → API Keys. RESEND_FROM must be an address on a
# domain you've verified in Resend (or use their onboarding@resend.dev for testing only —
# it only delivers to your own Resend account email, not real customers).
RESEND_API_KEY=
RESEND_FROM=DataPlug <no-reply@yourdomain.com>
